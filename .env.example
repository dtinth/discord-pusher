DISCORD_TOKEN=your-bot-token-here
# Comma-separated GatewayIntentBits names, e.g. Guilds,GuildMessages,MessageContent
DISCORD_INTENTS=Guilds,GuildMessages
PORT=8000
# Pusher-compatible server (for example Sockudo), in the form
#   https://<key>:<secret>@<host>[:<port>]/apps/<app_id>
PUSHER_URL=https://app-key:app-secret@pusher.example.com/apps/app-id
# Channel that receives all events. Use a "private-" prefix for a private channel.
PUSHER_CHANNEL=private-discord
